@dataset{decanioESAAnomalyDataset2024,
  title = {{{ESA Anomaly Dataset}}},
  author = {De Canio, Gabriele and Kotowski, Krzysztof and Haskamp, Christoph},
  namea = {Andrzejewski, Jacek and Ruszczak, Bogdan and Nalepa, Jakub and Lakey, Daniel and Collins, Peter and Kolmas, Aybike and Bartesaghi, Mauro and Martínez-Heras, Jose},
